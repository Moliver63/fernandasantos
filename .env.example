# ── Banco (Postgres no Render) ────────────────────────────
DATABASE_URL=postgresql://usuario:senha@host:5432/fsjoias

# URL pública do site, sem barra no final
SITE_URL=https://www.fsjoias.com.br
PORT=4000

# ── Asaas (Pix, boleto, cartão) ───────────────────────────
ASAAS_API_KEY=
ASAAS_ENV=sandbox
# Mesmo token configurado em Asaas > Integrações > Webhooks (obrigatório em produção)
ASAAS_WEBHOOK_TOKEN=

# ── Painel /admin ─────────────────────────────────────────
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ── Fotos das peças (Cloudflare Images) ───────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── E-mail (Resend) ───────────────────────────────────────
RESEND_API_KEY=
EMAIL_REMETENTE="FS Joias <pedidos@fsjoias.com.br>"
EMAIL_CONTATO="FS Joias <contato@fsjoias.com.br>"
RESEND_WEBHOOK_SECRET=
CRON_SECRET=

# ── Mensuração (padrão MecProAI) ──────────────────────────
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
GA4_MEASUREMENT_ID=
# URL criada no MecProAI: create_sales_webhook({ projectId, provider: "kiwify" })
MECPROAI_SALES_WEBHOOK_URL=
MECPROAI_SALES_WEBHOOK_SECRET=

# ── Instagram (vitrine da Home) ───────────────────────────
INSTAGRAM_ACCESS_TOKEN=
